// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int            @id @default(autoincrement())
  nome          String
  email         String         @unique
  telefone      String
  senha         String
  tipo          String         @default("cliente") // 'cliente' ou 'admin'

  agendamentos  Agendamento[]  @relation("UsuarioAgendamentos")
  avaliacoes    Avaliacao[]   // Relacionamento com avaliações
 }

model Servico {
  id            Int            @id @default(autoincrement())
  nome          String
  descricao     String
  duracaoMin    Int           // Armazena em minutos, ex.: 90 = 1h30
  preco         Float
  agendamentos  Agendamento[]
}

model Avaliacao {
  id         Int      @id @default(autoincrement())
  nota       Int
  comentario String
  data       DateTime @default(now())

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}


model Agendamento {
  id           Int       @id @default(autoincrement())
  data         DateTime
  hora         String
  status       String
  localizacao  String

  clienteId    Int
  cliente      Usuario   @relation("UsuarioAgendamentos", fields: [clienteId], references: [id])

  servicoId    Int
  servico      Servico   @relation(fields: [servicoId], references: [id])
}


