generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agendamento {
  id         Int      @id @default(autoincrement())
  data       DateTime
  hora       String
  cliente_id Int
  servico    Servico   @relation(fields: [servico_id], references: [id])
  servico_id Int
  status     String

  @@map("agendamentos")
}

model Servico {
  id        Int          @id @default(autoincrement())
  nome      String
  descricao String
  preco     Float
  agendamentos Agendamento[] // Relacionamento com agendamentos
}

